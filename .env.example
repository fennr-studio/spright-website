# ---------------------------------------------------------------------------
# Public site URL (used for canonical URLs, sitemap, Open Graph)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="https://www.sprightsoft.com"

# ---------------------------------------------------------------------------
# Transactional email (Resend). Server-only — never prefix these with NEXT_PUBLIC_.
# If RESEND_API_KEY is absent the API routes still validate and respond
# successfully, and log the payload instead of sending. This keeps local
# development and preview deploys working without credentials.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
CONTACT_FROM_EMAIL="website@sprightsoft.com"
CONTACT_TO_EMAIL="hr@sprightsoft.com"
